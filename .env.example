# Application Environment
NODE_ENV=development

# Server Configuration
PORT=3001
SERVER_URL=http://localhost:3001

# Client Configuration
CLIENT_URL=http://localhost:5173

# Supabase - Server (required)
# Get these from your Supabase project: Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Supabase - Client (required, must have VITE_ prefix for Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Gmail OAuth (optional - for email integration)
# Create OAuth credentials in Google Cloud Console with gmail.readonly scope
# Add redirect URI: http://localhost:3001/api/email/callback
GMAIL_CLIENT_ID=your-google-client-id
GMAIL_CLIENT_SECRET=your-google-client-secret

# OpenAI API Key (required for AI features)
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Encryption Key (required in production, recommended in development)
# Used to encrypt sensitive data like OAuth tokens and API keys stored in the database
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info
